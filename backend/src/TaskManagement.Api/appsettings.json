{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TaskManagementDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "TaskManagement.Api",
    "Audience": "TaskManagement.Client",
    "Key": "dev-only-signing-key-change-me-in-production-0123456789",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cache": {
    "TaskExpirationMinutes": 10,
    "RetryAfterFailureSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "BackgroundProcessing": {
    "SimulatedWorkSeconds": 5
  },
  "AdminSeed": {
    "Name": "Administrator",
    "Email": "admin@example.com",
    "Password": "Admin@123"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}